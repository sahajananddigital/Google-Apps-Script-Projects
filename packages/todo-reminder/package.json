{
  "name": "todo-reminder",
  "description": "Google Workspace todo manager with email reminders backed by Google Sheets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "vite build --config vite.config.js",
    "build:client": "vite build --config vite.config.client.js",
    "build": "npm run build:server && npm run build:client",
    "deploy": "npm run build && npm run upload",
    "dev": "vite build --config vite.config.js --mode development --watch",
    "upload": "npx clasp push"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/google-apps-script": "^2.0.8",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.8",
    "vite-plugin-singlefile": "^2.0.2",
    "vite-plugin-static-copy": "^4.0.1"
  }
}
