{
  "name": "gurukul-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "inventory:dev": "npm run dev -w packages/inventory-management-system",
    "inventory:build": "npm run build -w packages/inventory-management-system",
    "inventory:deploy": "npm run deploy -w packages/inventory-management-system",
    "accounts:dev": "npm run web:dev -w packages/gurukul-account-manager",
    "accounts:build": "npm run build -w packages/gurukul-account-manager",
    "accounts:deploy": "npm run deploy -w packages/gurukul-account-manager",
    "books:dev": "npm run web:dev -w packages/sahajanand-digital-books",
    "books:build": "npm run build -w packages/sahajanand-digital-books",
    "books:test": "npm test -w packages/sahajanand-digital-books",
    "books:deploy": "npm run deploy -w packages/sahajanand-digital-books",
    "tracker:dev": "npm run dev -w packages/harismruti-path-tracker",
    "tracker:build": "npm run build -w packages/harismruti-path-tracker",
    "tracker:deploy": "npm run deploy -w packages/harismruti-path-tracker",
    "todo:dev": "npm run dev -w packages/todo-reminder",
    "todo:build": "npm run build -w packages/todo-reminder",
    "todo:deploy": "npm run deploy -w packages/todo-reminder",
    "dev": "npm run inventory:dev",
    "build": "npm run inventory:build",
    "deploy": "npm run inventory:deploy"
  }
}
